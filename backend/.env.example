# 象生 XiangSheng 后端环境变量示例（复制为 .env 后按需取消注释）。
# 本文件只列变量名与占位说明，**不得**写入任何真实密码。

# --- MySQL 可选切换（不设置则继续使用默认 SQLite）---
# 应用运行时连接串：使用独立应用账号 xiangsheng_app（D-01），密码需 URL 编码。
# DATABASE_URL=mysql+pymysql://xiangsheng_app:<URL编码后的应用密码>@127.0.0.1:3306/xiangsheng_dev?charset=utf8mb4
# Alembic 专用连接串（留空则回退到 DATABASE_URL）。
# MIGRATION_DATABASE_URL=mysql+pymysql://<迁移账号>:<密码>@127.0.0.1:3306/xiangsheng_dev?charset=utf8mb4

# --- 仅初始化脚本 scripts/init_mysql_schema.py 使用，不写入本文件真实值 ---
# root 只用于一次性建库/建账号，不作为应用运行账号。
# MYSQL_ROOT_PASSWORD=
# MYSQL_APP_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=xiangsheng_dev
# MYSQL_APP_USER=xiangsheng_app

# --- 账号会话 ---
# AUTH_COOKIE_NAME=xs_auth
# AUTH_SESSION_ABSOLUTE_HOURS=24
# AUTH_SESSION_IDLE_HOURS=12
# AUTH_REMEMBER_ABSOLUTE_HOURS=720
# AUTH_REMEMBER_IDLE_HOURS=168
# AUTH_DEVELOPMENT_ACTIVE_ON_REGISTER=true

# --- 连接池（仅当 DATABASE_URL 指向 MySQL 时生效）---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# --- PPT AI 交互增强（与 LAB_AI_ENABLED 相互独立）---
# PPT_AI_ENABLED=true
# PPT_AI_HYBRID_MATCHING_ENABLED=true
# PPT_AI_GENERATED_VIEWS_ENABLED=false
# PPT_AI_TASK_MAX_CALLS=3
# PPT_AI_TASK_TIMEOUT_S=300
# PPT_AI_VIEW_TIMEOUT_MS=200
# PPT_AI_MAX_ARTIFACT_BYTES=8388608
# PPT_AI_MAX_LLM_TOKENS=4096

# Local visual understanding (separate from PPT AI)
LAB_UNDERSTANDING_PROVIDER=ollama
LAB_OLLAMA_URL=http://127.0.0.1:11434
LAB_OLLAMA_MODEL=qwen3-vl:2b-instruct-q4_K_M
