            ]
          },
          { "step": 2, "title": "组合各列", "partial": [0, 0], "result": [0, 0] }
        ]
      },
      "notes": "§2.2.3 黄金表 mx_zero_vector。零向量不特判，按公式自然得出；Ax=(0,0) 且 x≠0 时界面显示\"方向未定义\"（本用例 x=0，故不涉及）。"
    },
    {
      "id": "mx_singular",
      "title": "奇异矩阵：det=0，拒绝求逆",
      "input": {
        "matrix": [[1, 1], [2, 2]],
        "vector": [1, 0]
      },
      "expected": {
        "ax": [1, 2],
        "det": 0,
        "trace": 3,
        "rank": 1,
        "invertible": false,
        "inverse": null,
        "singular_reason": "矩阵奇异（det=0），零空间非平凡，无法把每个点送回原位",
        "ellipse": null,
        "eigenvalues": { "real": true, "values": [0, 3] }
      },
      "notes": "R6-AC10：不得伪造逆矩阵。rank 以 |det|>1e-12 判 2，否则任一分量绝对值>1e-12 判 1；ellipse 在 rank<2 时为 null。singular_reason 文案取自 §2.2.3 规则 5 原文。"
    },
    {
      "id": "mx_noncommute",
      "title": "复合顺序不可交换：ABx = (3, 2)，BAx = (2, 3)",
      "input": {
        "matrix": [[1, 1], [0, 1]],
        "second_matrix": [[1, 0], [1, 1]],
        "vector": [1, 1]
      },
      "expected": {
        "composition": {
          "order": "A_then_B",
          "ab": [[2, 1], [1, 1]],
          "ba": [[1, 1], [1, 2]],
          "abx": [3, 2],
          "bax": [2, 3],
          "commutes": false
        }
      },
      "notes": "R6-AC3 核心用例：abx=[3,2] 与 bax=[2,3] 必须同时出现且不相等。按 §2.3.6，ab = A·B 表示\"先 B 后 A\"；界面文案须写清\"先执行哪个\"，不得只用符号（C-12）。commutes 由 |abx-bax| <= 1e-9 判定。"
    },
