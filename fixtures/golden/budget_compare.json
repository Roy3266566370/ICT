    {
      "id": "bd_n80",
      "title": "n=80：方案A 9400.00 元，方案B 10000.00 元",
      "input": {
        "expressions": {
          "plan_a": {
            "op": "add",
            "args": [
              { "op": "ref", "parameter_id": "plan_a_fixed" },
              {
                "op": "multiply",
                "args": [
                  { "op": "ref", "parameter_id": "plan_a_per_person" },
                  { "op": "ref", "parameter_id": "people_n" }
                ]
              }
            ]
          },
          "plan_b": {
            "op": "add",
            "args": [
              { "op": "constant", "value": "6000" },
              {
                "op": "multiply",
                "args": [
                  { "op": "constant", "value": "50" },
                  { "op": "ref", "parameter_id": "people_n" }
                ]
              }
            ]
          }
        },
        "parameters": {
          "people_n": 80,
          "plan_a_fixed": "3000",
          "plan_a_per_person": "80",
          "plan_b_fixed": "6000",
          "plan_b_per_person": "50"
        },
        "people": 80,
        "budget_limit": null,
        "display_precision": 2
      },
      "expected": {
        "inputs": { "people": 80 },
        "scenarios": [
          {
            "scenario_id": "plan_a",
            "total": "9400.00",
            "per_person": "80.00",
            "fixed": "3000.00"
          },
          {
            "scenario_id": "plan_b",
            "total": "10000.00",
            "per_person": "50.00",
            "fixed": "6000.00"
          }
        ],
        "difference": "-600.00",
        "equal": false,
        "budget_limit": null,
        "remaining": null,
        "over_budget": null,
        "lines": [
          { "scenario_id": "plan_a", "at_zero": "3000.00", "at_max": "163000.00", "slope": "80.00" },
          { "scenario_id": "plan_b", "at_zero": "6000.00", "at_max": "106000.00", "slope": "50.00" }
        ],
        "display_precision": 2
      },
      "notes": "R9-AC1/R9-AC5。金额一律十进制字符串并按规则 7 统一 2 位小数（str(quantize(Decimal('0.01')))），禁止 float 参与（R9-AC3）。未设 budget_limit，故 remaining/over_budget 均为 null，界面不画预算线。lines.at_max 取 n=2000：A=3000+80*2000=163000，B=6000+50*2000=106000。AST 存放位置见 contracts/README.md 契约矛盾 C-06。"
    },
