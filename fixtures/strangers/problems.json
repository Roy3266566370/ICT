    {
      "id": "generic_param_limit_sin",
      "tags": [
        "含参极限",
        "目录外",
        "generic"
      ],
      "text": "已知 lim_{x→0} ((1+a*x^2)^sin(x)-1)/x^3 = L，求 a。",
      "plan": {
        "kind": "generic",
        "subject": "calculus",
        "symbols": [
          {
            "name": "x",
            "role": "independent"
          },
          {
            "name": "a",
            "role": "unknown"
          }
        ],
        "constants": [
          {
            "name": "L",
            "value": "6",
            "tunable": true,
            "min": 1,
            "max": 12
          }
        ],
        "steps": [
          {
            "id": "s1",
            "op": "limit",
            "expr": "((1+a*x^2)^sin(x)-1)/x^3",
            "var": "x",
            "point": "0"
          },
          {
            "id": "s2",
            "op": "solve",
            "equation": "s1 = L",
            "for": [
              "a"
            ]
          }
        ],
        "target": {
          "step": "s2",
          "label": "a"
        },
        "plot": {
          "expr": "((1+a*x^2)^sin(x)-1)/x^3",
          "var": "x",
          "range": [
            -1,
            1
          ]
        }
      },
      "expect": {
        "status": "ready",
        "answer_contains": "a=6"
      }
    },
