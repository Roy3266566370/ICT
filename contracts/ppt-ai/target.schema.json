{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xiangsheng:ppt-ai:target:1",
  "title": "PPT AI TargetResult ppt-ai.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "output",
    "target_value",
    "candidates",
    "method",
    "tolerance",
    "atol",
    "rtol",
    "search_scope",
    "iterations",
    "stop_reason",
    "checks"
  ],
  "properties": {
    "status": {
      "enum": ["found", "multiple", "none_in_scope", "unknown", "timeout", "infeasible_proven"]
    },
    "output": { "type": "string", "minLength": 1, "maxLength": 80 },
    "target_value": { "type": "number" },
    "candidates": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "method": { "type": "string", "maxLength": 120 },
    "tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "atol": { "type": "number", "exclusiveMinimum": 0 },
    "rtol": { "type": "number", "exclusiveMinimum": 0 },
    "residual": { "type": ["number", "null"] },
    "search_scope": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "iterations": { "type": "integer", "minimum": 0 },
    "stop_reason": { "type": "string", "maxLength": 200 },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "object" }
    },
    "candidate_branch_id": { "type": ["string", "null"], "maxLength": 96 }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "output_value", "residual", "method"],
      "properties": {
        "values": { "type": "object" },
        "output_value": { "type": ["number", "null"] },
        "residual": { "type": ["number", "null"] },
        "method": { "type": "string", "maxLength": 120 },
        "solution": { "$ref": "#/$defs/solution" }
      }
    },
    "solution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["unknowns", "values", "classification"],
      "properties": {
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "number" }
        },
        "classification": { "enum": ["unique", "particular", "scalar_candidate"] },
        "exact_values": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 120 }
        },
        "free_variables": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 96 }
        },
        "nullspace_basis": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "number" }
          }
        },
        "equations": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 300 }
        },
        "verification": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "object" }
        }
      }
    }
  }
}
