{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xiangsheng:ppt-ai:view:1",
  "title": "PPT AI ViewAST ppt-ai.view.1",
  "description": "声明式视图协议。禁止事件脚本、foreignObject、任意 URL、HTML 注入与未登记资源。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes", "interactions"],
  "properties": {
    "version": {"const": "ppt-ai.view.1"},
    "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
    "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
    "interactions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "action", "target"],
        "properties": {
          "event": {"enum": ["set_parameter", "seek", "select"]},
          "action": {"enum": ["set_parameter", "seek", "select"]},
          "target": {"type": "string", "maxLength": 96},
          "value": {
            "oneOf": [
              {"type": "number"}, {"type": "boolean"}, {"type": "string"}
            ]
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {"type": ["string", "null"], "pattern": "^(#[0-9a-fA-F]{6}|transparent|none)$"},
        "stroke": {"type": ["string", "null"], "pattern": "^(#[0-9a-fA-F]{6}|transparent|none)$"},
        "strokeWidth": {"type": "number", "minimum": 0, "maximum": 40},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "fontSize": {"type": "number", "minimum": 6, "maximum": 96},
        "fontWeight": {"enum": ["normal", "bold", 400, 600, 700]},
        "textAnchor": {"enum": ["start", "middle", "end"]},
        "align": {"enum": ["left", "center", "right"]},
        "dash": {"type": "array", "items": {"type": "number"}, "maxItems": 8},
        "arrowStart": {"type": "boolean"},
        "arrowEnd": {"type": "boolean"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "type": {"enum": ["group", "text", "point", "line", "polyline", "rect", "circle", "axes", "curve", "heatmap", "scene3d", "mermaid", "chart"]},
        "binding": {"type": ["string", "null"], "maxLength": 96},
        "x": {"type": "number"}, "y": {"type": "number"},
        "w": {"type": "number", "minimum": 0}, "h": {"type": "number", "minimum": 0},
        "x1": {"type": "number"}, "y1": {"type": "number"},
        "x2": {"type": "number"}, "y2": {"type": "number"},
        "cx": {"type": "number"}, "cy": {"type": "number"},
        "r": {"type": "number", "minimum": 0},
        "text": {"type": "string", "maxLength": 2000},
        "points": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/point"}},
        "series": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/point"}},
        "x_min": {"type": "number"}, "x_max": {"type": "number"},
        "y_min": {"type": "number"}, "y_max": {"type": "number"},
        "ticks": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/point"}},
        "cells": {"type": "array", "maxItems": 10000, "items": {"type": "array", "items": {"type": "number"}}},
        "rows": {"type": "array", "maxItems": 500, "items": {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}},
        "columns": {"type": "array", "maxItems": 50, "items": {"type": "string"}},
        "children": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/node"}},
        "scene3d": {
          "type": "object",
          "additionalProperties": false,
          "required": ["renderer", "kind"],
          "properties": {
            "renderer": {"const": "trusted-three"},
            "kind": {"type": "string", "maxLength": 48},
            "params": {"type": "object"}
          }
        },
        "mermaid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {"type": "string", "minLength": 4, "maxLength": 4000},
            "activeNodes": {
              "type": "array",
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 48}
            },
            "theme": {"enum": ["warm", "neutral", "default"]}
          }
        },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chartType", "series"],
          "properties": {
            "chartType": {"enum": ["bar", "line", "area", "scatter", "pie"]},
            "title": {"type": "string", "maxLength": 80},
            "xLabel": {"type": "string", "maxLength": 40},
            "yLabel": {"type": "string", "maxLength": 40},
            "categories": {
              "type": "array",
              "maxItems": 40,
              "items": {"type": "string", "minLength": 1, "maxLength": 48}
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "values"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 48},
                  "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "oneOf": [
                        {"type": "number"},
                        {"$ref": "#/$defs/point"}
                      ]
                    }
                  }
                }
              }
            },
            "yDomain": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "style": {"$ref": "#/$defs/style"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}}, "then": {"required": ["x", "y", "text"]}},
        {"if": {"properties": {"type": {"const": "point"}}}, "then": {"required": ["x", "y"]}},
        {"if": {"properties": {"type": {"const": "line"}}}, "then": {"required": ["x1", "y1", "x2", "y2"]}},
        {"if": {"properties": {"type": {"const": "polyline"}}}, "then": {"required": ["points"]}},
        {"if": {"properties": {"type": {"const": "rect"}}}, "then": {"required": ["x", "y", "w", "h"]}},
        {"if": {"properties": {"type": {"const": "circle"}}}, "then": {"required": ["cx", "cy", "r"]}},
        {"if": {"properties": {"type": {"const": "axes"}}}, "then": {"required": ["x_min", "x_max", "y_min", "y_max"]}},
        {"if": {"properties": {"type": {"const": "curve"}}}, "then": {"required": ["series", "x_min", "x_max", "y_min", "y_max"]}},
        {"if": {"properties": {"type": {"const": "heatmap"}}}, "then": {"required": ["cells", "x_min", "x_max", "y_min", "y_max"]}},
        {"if": {"properties": {"type": {"const": "group"}}}, "then": {"required": ["children"]}},
        {"if": {"properties": {"type": {"const": "scene3d"}}}, "then": {"required": ["scene3d"]}},
        {"if": {"properties": {"type": {"const": "mermaid"}}}, "then": {"required": ["mermaid"]}},
        {"if": {"properties": {"type": {"const": "chart"}}}, "then": {"required": ["chart"]}}
      ]
    }
  }
}
