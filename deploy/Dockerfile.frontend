# syntax=docker/dockerfile:1
#
# 象生 XiangSheng v0.2 —— 前端镜像（多阶段：Node 构建 → nginx 托管）
#
# 构建上下文必须是仓库根（deploy/docker-compose.yml 使用 context: ..），因为
# vite.config.ts 的 fixturesPlugin 需要读取仓库根的 fixtures/**：
#   const repoRoot = path.resolve(here, '..')   // 容器内 here=/app → repoRoot=/
#   const fixturesRoot = path.join(repoRoot, 'fixtures')   // → /fixtures
# 因此这里把所需 fixtures 子目录复制到 /fixtures，构建产物会 emit 到 dist/fixtures/**。

# ---------------------------------------------------------------------------
# 阶段 1：构建
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# 仓库自带 frontend/package-lock.json（lockfileVersion 3），因此使用 npm ci
# 保证可复现的依赖树；若未来删掉 lockfile，请改用 npm install。
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 只复制 mock 运行时真正读取的 fixtures（examples / golden / materials），
# 不复制 fixtures/ppt 的二进制原件，避免无谓放大构建上下文。
COPY fixtures/examples /fixtures/examples
COPY fixtures/golden /fixtures/golden
COPY fixtures/materials /fixtures/materials

COPY frontend/ ./

# VITE_API_BASE 在构建期固化到静态产物：
#   - 空字符串 = mock 模式（读 /fixtures/**）
#   - origin   = 真实 API（客户端自行拼接 /api/v1）
# nginx 将 /api/ 反代到 backend:8000，浏览器侧 Origin 是宿主机地址，
# 所以默认取 compose 暴露的 http://localhost:8080；生产请改为实际域名。
ARG VITE_API_BASE=http://localhost:8080
ENV VITE_API_BASE=${VITE_API_BASE}

RUN npm run build

# ---------------------------------------------------------------------------
# 阶段 2：运行时（只含静态产物与 nginx，不含 Node 与源码）
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# 覆盖默认站点配置：SPA fallback + /api/ 反代 + /fixtures/ 静态 + 安全响应头。
# 注意：nginx 镜像内的 /usr/share/nginx/html 是唯一 web root，
# 镜像中不包含 .env、源码或构建缓存，因此不会通过 HTTP 暴露。
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# alpine 镜像自带 busybox wget；不依赖 curl。
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
