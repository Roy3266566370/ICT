# syntax=docker/dockerfile:1
#
# 象生 XiangSheng v0.2 —— 后端镜像（FastAPI + SQLAlchemy + SQLite）
#
# 构建上下文必须是仓库根（deploy/docker-compose.yml 使用 context: ..），因为
# backend/app/settings.py 按目录关系定位夹具：
#   BACKEND_DIR = /app          （app/settings.py 的上两级）
#   REPO_ROOT   = /             （BACKEND_DIR 的上一级）
#   FIXTURES_DIR = /fixtures    → 需要把仓库根 fixtures/ 复制到 /fixtures
#   DATA_DIR     = /app/data    → compose 挂载 ./backend/data:/app/data 持久化 SQLite
#
# 工作目录与启动方式：
#   本地：python -m uvicorn app.main:app --app-dir backend
#   容器：WORKDIR /app 等价于 --app-dir /app，故 CMD 直接写 app.main:app。

FROM node:22-alpine AS offline-runtime
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build:offline

FROM python:3.11-slim

# 不写 .pyc、日志不缓冲，便于容器日志实时输出。
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 先建非 root 用户；容器内不以 root 运行。
RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

# 依赖层单独缓存：只要 requirements.txt 不变就不会重复安装。
COPY backend/requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt

# 应用代码（tests / scripts 一并复制，便于在容器内跑 selftest.py）。
COPY backend/ /app/
COPY --from=offline-runtime /build/backend/app/static/offline/ /app/app/static/offline/

# 只读夹具：示例、黄金用例、课程材料产物、导出图（资源代理读取）。
COPY fixtures/ /fixtures/

# 数据目录必须先存在且归属非 root 用户；compose 会把宿主机目录挂到这里。
RUN mkdir -p /app/data/uploads \
    && chown -R app:app /app/data

USER app

EXPOSE 8000

# 用标准库探活，避免为了 healthcheck 额外装 curl。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/openapi.json', timeout=3)" || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
