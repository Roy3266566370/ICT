# 象生 XiangSheng v0.2 —— 环境变量占位模板
#
# 用法：复制为 .env 后按需修改（Windows: copy .env.example .env；PowerShell: Copy-Item .env.example .env）。
# 本文件只允许占位值：禁止提交任何真实密钥、Token、云账号或生产域名凭据。
# 后端读取变量名以 backend/app/settings.py 为准（大小写不敏感）。

# ---------------------------------------------------------------------------
# 后端（FastAPI）
# ---------------------------------------------------------------------------

# 会话签名密钥。必须由部署环境注入，禁止提交真实值。
# 留空时后端会随机生成一次性密钥并写告警日志：进程重启后旧会话 Cookie 全部失效。
SESSION_SECRET=

# 会话 Cookie 的 Secure 属性。
# 本地 HTTP 必须为 false；生产 HTTPS 必须改为 true，否则浏览器不会回传 Cookie。
SESSION_COOKIE_SECURE=false

# 访客会话有效期（小时）。示例：24
SESSION_TTL_HOURS=24

# 访客材料保留期（小时）。示例：24
MATERIAL_RETENTION_HOURS=24

# SQLite 连接串。相对路径以进程工作目录为基准：
#   - 本地在仓库根执行 uvicorn 时为 ./data/...，由 settings 解析到 backend/data/
#   - Docker 内 WORKDIR=/app，等价 /app/data/xiangsheng.db
# 也可改成绝对路径，例如 sqlite:////data/xiangsheng.db
DATABASE_URL=sqlite:///./data/xiangsheng.db

# 写请求 Origin 白名单（逗号分隔，不要带尾斜杠）。
# 5173 = `npm run dev`；8080 = Docker 下经 nginx 同源访问。
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 后端代码实际读取的变量名（与 CORS_ORIGINS 同义）。
# docker compose 会用 CORS_ORIGINS 插值后写入本项；本地直接跑 uvicorn 时读本项。
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# 单文件上传上限（MB，可读别名，便于人工核对）。
UPLOAD_MAX_MB=70

# 后端实际读取的字节数上限（70 MB = 70 × 1024 × 1024）。
MAX_UPLOAD_BYTES=73400320

# 单份材料页数上限（可读别名）。
UPLOAD_MAX_PAGES=60

# 后端实际读取的页数上限。
MAX_SLIDE_PAGES=60

# PPTX 解压后总字节上限（200 MB，用于拦截压缩炸弹）。
MAX_UNZIPPED_BYTES=209715200

# 写请求是否校验 X-CSRF-Token。安全起见保持 true；只有本地调试 mock 时才考虑关闭。
ENFORCE_CSRF=true

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 识别层 LLM。以下 LLM_* 是 build_provider() 实际读取的配置。
# 本地可写入 backend/.env；默认关闭，密钥只保存在后端配置中。
# 示例文件始终留空密钥，禁止把真实密钥提交到仓库。
# ---------------------------------------------------------------------------

# none = 不调用模型；maas = 使用下面配置的华为云兼容接口。
LLM_PROVIDER=maas

# 华为云标准 API V2 根地址，不包含 /chat/completions。
LLM_BASE_URL=https://api.modelarts-maas.com/v2

# 按控制台 API 示例填写完整 model 值。
LLM_MODEL=deepseek-v4.1-flash-1017
LAB_UNDERSTANDING_PROVIDER=maas

# 模型访问密钥（占位空值；禁止使用 VITE_ 前缀）。
LLM_API_KEY=

# 单次调用超时（秒）。
LLM_TIMEOUT_S=60
# 声明式建模使用结构化输出；不支持 json_schema 的兼容端点可关闭。
LLM_JSON_SCHEMA=true

# 单份材料允许的最大调用页数；0 = 关闭模型补识别。
LLM_MAX_CALLS=3

# 旧 ISEPC_LLM_* 字段保留在 Settings 中供历史兼容，
# 当前真实 provider 不读取它们，请使用上面的 LLM_*。

# ---------------------------------------------------------------------------
# 题目交互实验室
# 默认 false：识别、求解、讲解全部在本地完成，不产生任何模型调用费用。
# 只有显式改为 true，且学生当次请求勾选“使用模型增强”时，才可能调用上面的 LLM。
# ---------------------------------------------------------------------------
LAB_AI_ENABLED=false
LAB_MAX_FILES=6
LAB_MAX_PAGES=20
LAB_MAX_TEXT_CHARS=30000

# ---------------------------------------------------------------------------
# 前端（Vite，变量必须以 VITE_ 开头才会注入浏览器）
# ---------------------------------------------------------------------------

# API 基址，只写 origin，不要带 /api/v1（客户端会自行拼接）。
#   留空           = 离线 mock 模式，读取 fixtures/**，不需要后端
#   http://127.0.0.1:8000  = 本地真实后端
#   http://localhost:8080  = Docker 经 nginx 同源部署（或替换为实际域名）
# 注意：docker compose 对"空值"使用默认 http://localhost:8080，因此容器默认连真实后端；
# 若要在容器里跑 mock，请显式修改 compose 的 build.args 或提供非空值后回退。
VITE_API_BASE=

# ---------------------------------------------------------------------------
# 部署（docker compose 插值）
# ---------------------------------------------------------------------------

# 前端对外端口（宿主机侧）。容器内 nginx 固定监听 80。
# 示例：8080（被占用时改成 8081 等）
FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# 自由编辑对象分离（Windows 转换服务，可选）
# ---------------------------------------------------------------------------

# 主后端不在 Windows/无 PowerPoint 时，把对象分离委托给独立 Windows 服务。
# 留空 = 使用本机 PowerPoint COM。
LAYER_EXPORT_SERVICE_URL=

# 转换服务的 Bearer 令牌；与服务端 LAYER_EXPORT_SERVICE_TOKEN 一致。
LAYER_EXPORT_SERVICE_TOKEN=
