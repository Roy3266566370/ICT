{
  "name": "xiangsheng-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "象生 XiangSheng v0.2 前端（React 18 + TypeScript + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:offline",
    "build:offline": "vite build --config vite.offline.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:conversion": "node scripts/test-conversion.mjs",
    "test:core": "node scripts/test-core.mjs && node scripts/test-deck-persistence.mjs && node scripts/test-document.mjs",
    "test": "npm run test:core && npm run test:conversion && node --test \"src/**/*.test.ts\"",
    "test:ppt-ai:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:ppt-ai:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.173.0",
    "@tanstack/react-query": "^5.59.16",
    "@xyflow/react": "^13.0.2",
    "katex": "^0.16.11",
    "mafs": "^0.21.0",
    "mathlive": "^0.111.4",
    "mermaid": "^12.3.0",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.27.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.187.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
