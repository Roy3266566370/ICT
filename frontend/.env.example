# ---------------------------------------------------------------------------
# 象生 XiangSheng 前端环境变量占位
# 复制为 frontend/.env.local 后按需修改；不要提交任何真实密钥。
# ---------------------------------------------------------------------------

# 后端 origin，留空时通过 Vite /api 代理连接真实后端。
# 例如 http://127.0.0.1:8000，不带 /api/v1。
# 仅显式设置 VITE_USE_MOCK=true 时使用离线演示数据。
VITE_API_BASE=
VITE_USE_MOCK=false
